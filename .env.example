# Omega Platform — environment variable NAMES only. No real values, ever.
# Copy to `.env` locally and fill in; `.env` is gitignored.

# Edge worker (apps/worker)
OMEGA_ENV=local

# Web app (apps/web)
NEXT_PUBLIC_OMEGA_ENV=local

# Contract deployment (contracts/) — set in your shell or CI secrets, never commit values
# DEPLOYER_PRIVATE_KEY=
# BASE_RPC_URL=
# BASESCAN_API_KEY=

# Meta Model API (hackathon build window) — names only; set real values in your shell/CI secrets
# META_MODEL_API_KEY=
# MODEL_API_KEY=           (Meta's documented name — accepted as an alias)
# META_MODEL_BASE_URL=
# META_MODEL_MODEL=
# META_MODEL_IMAGE_MODEL=
